{
  "name": "switchback-mobile",
  "private": true,
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "styles": "node scripts/make-styles.mjs",
    "prebuild": "expo prebuild --clean --no-install",
    "android:release": "cd android && ./gradlew assembleRelease",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "export:check": "expo export --platform android --output-dir dist-check && expo export --platform ios --output-dir dist-check"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.14",
    "@maplibre/maplibre-react-native": "11.5.1",
    "@preact/signals-core": "1.14.5",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@shopify/flash-list": "2.3.2",
    "expo": "58.0.24",
    "expo-build-properties": "58.0.12",
    "expo-constants": "58.0.16",
    "expo-dev-client": "58.0.19",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.12",
    "expo-haptics": "58.0.8",
    "expo-keep-awake": "58.0.4",
    "expo-location": "58.0.21",
    "expo-network": "58.0.5",
    "expo-notifications": "58.1.9",
    "expo-sharing": "58.0.23",
    "expo-splash-screen": "58.0.14",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "expo-task-manager": "58.0.14",
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "typescript": "6.0.3"
  }
}
