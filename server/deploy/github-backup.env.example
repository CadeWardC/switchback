# Nightly database backups to a private GitHub repo. Copy to /etc/switchback/github-backup.env, fill in, then run
# setup-pi.sh again. Keep it private: sudo chmod 600 /etc/switchback/github-backup.env
#
# Each backup is encrypted on the Pi with age before it leaves, so only the key on your computer can open it.
# Backups are files on the repo's "db-backups" release (not commits), and ones older than KEEP_DAYS are deleted, so
# a deleted account is gone from the backups after that many days.

# The private repo, e.g. CadeWardC/switchback-backups (create it on GitHub with a README so it isn't empty)
GITHUB_REPO=

# A fine-grained token: github.com › Settings › Developer settings › Fine-grained tokens › Generate.
# Repository access: only the backup repo. Permissions: Contents: Read and write. Nothing else.
GITHUB_TOKEN=

# Your age public key (starts with age1...). Make it on your computer: age-keygen -o switchback-backup-key.txt
AGE_RECIPIENT=

# How many days of backups to keep
KEEP_DAYS=14

# Optional: a check URL from healthchecks.io (free). It emails you if the nightly job fails or stops running.
HEALTHCHECK_URL=
