# Backups to Cloudflare R2 (free for the first 10 GB). Copy to /etc/switchback/backup.env, fill in, then run
# setup-pi.sh again. Keep this file private: sudo chmod 600 /etc/switchback/backup.env
#
# In the Cloudflare dashboard: R2 › Create bucket (e.g. switchback-backups), then
# R2 › Manage API tokens › Create API token › "Object Read & Write" for that bucket.

# The account id shown on the R2 overview page
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=switchback-backups

# Optional: a check URL from healthchecks.io (free). It emails you if the nightly job fails or stops running.
HEALTHCHECK_URL=
