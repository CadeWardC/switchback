{
  "name": "switchback-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "styles": "node scripts/make-styles.mjs",
    "dev": "npm run styles && vite",
    "build": "npm run styles && tsc --noEmit && vite build && node scripts/make-sw.mjs",
    "preview": "vite preview",
    "test": "npm run styles && vitest run",
    "build:app": "npm run build && node scripts/strip-app.mjs && cap sync",
    "android": "npm run build:app && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@preact/signals": "^2.11.4",
    "maplibre-gl": "^6.18.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
